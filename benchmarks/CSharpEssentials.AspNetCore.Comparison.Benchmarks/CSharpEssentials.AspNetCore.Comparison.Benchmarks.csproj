<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CA1822;CA1050;CA1812;S101;S3903;S1118;CA1515;S2068;IDE0008;IDE0021;IDE0005;IDE0078</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\CSharpEssentials.Enums\build\CSharpEssentials.Enums.props" />

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Hellang.Middleware.ProblemDetails" />
    <PackageReference Include="IdempotentAPI" />
    <PackageReference Include="IdempotentAPI.MinimalAPI" />
    <PackageReference Include="IdempotentAPI.Cache.DistributedCache" />
    <PackageReference Include="Marvin.Cache.Headers" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="SharpGrip.FluentValidation.AutoValidation.Endpoints" />
    <PackageReference Include="FluentValidation" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CSharpEssentials.AspNetCore\CSharpEssentials.AspNetCore.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.Idempotency\CSharpEssentials.Idempotency.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.RequestResponseLogging\CSharpEssentials.RequestResponseLogging.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.Results\CSharpEssentials.Results.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.Errors\CSharpEssentials.Errors.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.Validation\CSharpEssentials.Validation.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.Enums\CSharpEssentials.Enums.csproj" />
    <ProjectReference Include="..\..\CSharpEssentials.Enums.Generators\CSharpEssentials.Enums.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
