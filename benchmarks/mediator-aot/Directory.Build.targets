<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))"
          Condition="Exists($([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../')))" />

  <!-- Let Mediator.Abstractions 3.0.2 (VersionOverride, equal to the generator) and Microsoft.Extensions.DependencyInjection 10
       resolve their transitive versions as a real consumer would; the repo-wide transitive pins are lower. Set here because
       Directory.Packages.props is imported after Directory.Build.props and would override it there. -->
  <PropertyGroup>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
</Project>
