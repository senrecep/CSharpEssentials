<!-- Directory.Build.targets - Rules applied after each project has declared its items -->
<Project>
	<!-- Any CSharpEssentials package brings the CSharpEssentials.Enums generator and analyzers. A reference without PrivateAssets
	     packs as exclude="Build,Analyzers", which would stop them one package before the consumer, so a packable project's
	     references to other CSharpEssentials projects and packages default to PrivateAssets="contentfiles;build" (exclude="Build").
	     Build stays private: buildTransitive/ already reaches transitive consumers. A reference that sets PrivateAssets keeps its
	     value (the generator and code fix projects use "all"), and references that skip the output assembly are left alone. -->
	<ItemGroup Condition="'$(IsPackable)' == 'true'">
		<PackageReference Update="@(PackageReference)">
			<PrivateAssets Condition="'%(PrivateAssets)' == '' and $([System.String]::Copy('%(Identity)').StartsWith('CSharpEssentials'))">contentfiles;build</PrivateAssets>
		</PackageReference>
		<ProjectReference Update="@(ProjectReference)">
			<PrivateAssets Condition="'%(PrivateAssets)' == '' and '%(ReferenceOutputAssembly)' != 'false' and $([System.String]::Copy('%(Filename)').StartsWith('CSharpEssentials'))">contentfiles;build</PrivateAssets>
		</ProjectReference>
	</ItemGroup>

	<!-- Each package carries its agent skill at skills/<name>/SKILL.md, the layout agent tools read from restored packages
	     (https://devblogs.microsoft.com/dotnet/delivering-skills-in-nuget-packages/). The source stays in .well-known/agent-skills.
	     The skill name defaults to csharpessentials-<project suffix in lower case>; a project can set PackageSkillName itself. -->
	<PropertyGroup Condition="'$(IsPackable)' == 'true' and '$(PackageSkillName)' == ''">
		<PackageSkillName Condition="'$(MSBuildProjectName)' == 'CSharpEssentials'">csharpessentials-meta</PackageSkillName>
		<PackageSkillName Condition="'$(MSBuildProjectName)' == 'CSharpEssentials.EntityFrameworkCore'">csharpessentials-efcore</PackageSkillName>
		<PackageSkillName Condition="'$(MSBuildProjectName)' == 'CSharpEssentials.RequestResponseLogging'">csharpessentials-logging</PackageSkillName>
		<PackageSkillName Condition="'$(MSBuildProjectName)' == 'CSharpEssentials.AspNetCore.OpenApi' or '$(MSBuildProjectName)' == 'CSharpEssentials.AspNetCore.Swashbuckle'">csharpessentials-aspnetcore</PackageSkillName>
		<PackageSkillName Condition="'$(PackageSkillName)' == '' and $(MSBuildProjectName.StartsWith('CSharpEssentials.'))">csharpessentials-$(MSBuildProjectName.Substring(17).ToLowerInvariant())</PackageSkillName>
	</PropertyGroup>
	<PropertyGroup Condition="'$(PackageSkillName)' != ''">
		<PackageSkillFile>$(MSBuildThisFileDirectory).well-known/agent-skills/$(PackageSkillName)/SKILL.md</PackageSkillFile>
	</PropertyGroup>
	<ItemGroup Condition="'$(IsPackable)' == 'true' and '$(PackageSkillFile)' != '' and Exists('$(PackageSkillFile)')">
		<None Include="$(PackageSkillFile)" Pack="true" PackagePath="skills/$(PackageSkillName)/" Visible="false" />
	</ItemGroup>
</Project>
