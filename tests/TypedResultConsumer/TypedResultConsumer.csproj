<Project Sdk="Microsoft.NET.Sdk">

  <!-- Outside the solution. Builds one file from Cases/ per run with the real SDK, so scripts/check-typed-consumer.py can assert
       the diagnostics a consumer sees: a clean build for full coverage, CS8509, CS0457, CS0029 and CS0161 for the broken cases.
       The Typed* cases use the shipped Result<T, E1..E3> from CSharpEssentials.Results, the others the inline R in Union.cs.
       Build: dotnet build tests/TypedResultConsumer -p:FixtureCase=MissingArm -p:CseVersion=<packed> -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CSharpEssentials.Errors" />
    <PackageReference Include="CSharpEssentials.Results" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Cases/**" />
    <Compile Include="Cases/$(FixtureCase).cs" />
  </ItemGroup>

</Project>
