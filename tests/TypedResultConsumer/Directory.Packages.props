<!-- CseVersion is the version passed to dotnet pack. -->
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="CSharpEssentials.Errors" Version="$(CseVersion)" />
    <PackageVersion Include="CSharpEssentials.Results" Version="$(CseVersion)" />
  </ItemGroup>
</Project>
