<Project>
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
    </PropertyGroup>

    <!-- AspNetCore -->
    <ItemGroup Label="AspNetCore">
        <PackageVersion Include="Asp.Versioning.Http" Version="[8.1.0,)" />
        <PackageVersion Include="Asp.Versioning.Mvc" Version="[8.1.0,)" />
        <PackageVersion Include="Asp.Versioning.Mvc.ApiExplorer" Version="[8.1.0,)" />
        <PackageVersion Include="Swashbuckle.AspNetCore" Version="[8.1.0,10)" />
    </ItemGroup>

    <!-- OpenApi: only CSharpEssentials.AspNetCore.OpenApi and its tests (approved 2026-10-06). Microsoft.OpenApi 2.x is pinned only
         where CSharpEssentialsUsesOpenApi2 is set, because transitive pinning would otherwise force 2.x on Swashbuckle (1.x).
         2.7.5 is the first 2.x without GHSA-v5pm-xwqc-g5wc (Microsoft.AspNetCore.OpenApi 10.0.0 asks for 2.0.0).
         No net11.0 target: Microsoft.AspNetCore.OpenApi 11.x (rc.1 only) needs Microsoft.OpenApi [3.10.0,4.0.0), which conflicts
         with this 2.x pin on any net11.0 host. net11.0 with Microsoft.OpenApi 3.x comes later as a non-breaking addition. -->
    <ItemGroup Label="OpenApi">
        <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="[10.0.0,11)" />
        <PackageVersion Include="Microsoft.OpenApi" Version="[2.7.5,3)" Condition="'$(CSharpEssentialsUsesOpenApi2)' == 'true'" />
    </ItemGroup>

    <!-- EntityFrameworkCore -->
    <ItemGroup Label="EntityFrameworkCore">
        <PackageVersion Include="EFCore.NamingConventions" Version="[9.0.0,10)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="[9.0.4,10)" />
    </ItemGroup>

    <!-- System -->
    <ItemGroup Label="System">
        <PackageVersion Include="System.Memory" Version="[4.5.5,)" />
        <PackageVersion Include="System.Net.Http.Json" Version="[9.0.0,)" />
        <PackageVersion Include="System.Text.Json" Version="[9.0.4,)" />
        <PackageVersion Include="System.Threading.Tasks.Extensions" Version="[4.5.4,)" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Abstractions" Version="[9.0.4,)" />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="[9.0.4,)" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="[9.0.4,)" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="[9.0.4,)" />
        <PackageVersion Include="Microsoft.Extensions.Http" Version="[9.0.4,)" />
    </ItemGroup>

    <!-- Mediator -->
    <ItemGroup Label="Mediator">
        <PackageVersion Include="Mediator.Abstractions" Version="[3.0.1,)" />
    </ItemGroup>

    <!-- Infrastructure -->
    <ItemGroup Label="Infrastructure">
        <PackageVersion Include="Google.Cloud.SecretManager.V1" Version="[2.6.0,)" />
        <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="[8.0.0,)" />
        <PackageVersion Include="Microsoft.Extensions.Configuration" Version="[9.0.4,)" />
        <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="[9.0.4,)" />
        <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="[3.0.1,)" />
        <PackageVersion Include="Polly.Core" Version="[8.0.0,9.0.0)" />
    </ItemGroup>

    <!-- CSharpEssentials Internal Packages -->
    <ItemGroup Label="CSharpEssentials">
        <PackageVersion Include="CSharpEssentials.Any" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.AspNetCore" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Clone" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Core" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.DependencyInjection" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Entity" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Endpoints" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Enums" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Errors" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Http" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Json" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Maybe" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Mediator" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Resilience" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Results" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Rules" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.These" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Time" Version="[$(Version)]" />
        <PackageVersion Include="CSharpEssentials.Validation" Version="[$(Version)]" />
    </ItemGroup>

    <!-- Test -->
    <ItemGroup Label="Test">
        <PackageVersion Include="Bogus" Version="35.6.5" />
        <PackageVersion Include="coverlet.collector" Version="10.0.0" />
        <PackageVersion Include="FluentAssertions" Version="8.9.0" />
        <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.4" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.4" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.5.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
        <PackageVersion Include="Moq" Version="4.20.72" />
        <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
        <PackageVersion Include="Testcontainers" Version="4.11.0" />
        <PackageVersion Include="Testcontainers.PostgreSql" Version="4.11.0" />
        <PackageVersion Include="Verify.SourceGenerators" Version="2.5.0" />
        <PackageVersion Include="Verify.Xunit" Version="31.12.5" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

    <!-- Examples -->
    <ItemGroup Label="Examples">
        <PackageVersion Include="Asp.Versioning.Abstractions" Version="[8.1.0,)" />
        <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.4" />
        <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.4" />
    </ItemGroup>

    <!-- Build -->
    <ItemGroup Label="Build">
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="[1.1.1,)" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[4.13.0,)" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="[4.13.0,)" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="[3.11.0,)" />
    </ItemGroup>

    <!-- Benchmarks -->
    <ItemGroup Label="Benchmarks">
        <PackageVersion Include="BenchmarkDotNet" Version="[0.14.0,)" />
        <PackageVersion Include="FluentValidation" Version="[11.11.0,)" />
    </ItemGroup>

    <!-- Analyzers -->
    <ItemGroup Label="Analyzers">
        <PackageVersion Include="SonarAnalyzer.CSharp" Version="*" />
    </ItemGroup>
</Project>
