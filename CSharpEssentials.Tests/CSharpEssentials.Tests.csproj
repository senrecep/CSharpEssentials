<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\CSharpEssentials.DependencyInjection\build\CSharpEssentials.DependencyInjection.props" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Bogus" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Verify.SourceGenerators" />
    <PackageReference Include="Verify.Xunit" />
    <PackageReference Include="Microsoft.Extensions.Configuration" VersionOverride="9.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" VersionOverride="9.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" ExcludeAssets="all" />
  </ItemGroup>

  <Import Project="..\CSharpEssentials.Endpoints\build\CSharpEssentials.Endpoints.props" />
  <Import Project="..\CSharpEssentials.Enums\build\CSharpEssentials.Enums.props" />

  <!-- Copy the resolved Enums and Endpoints analyzers (netstandard2.0 ProjectReference output) next to the tests for the generator and analyzer tests.
       Runs after the reference is resolved and before AssignTargetPaths, so the None item is always copied. -->
  <Target Name="CopyEnumsAnalyzerForTests" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(Analyzer)"
            Condition="'%(Filename)%(Extension)' == 'CSharpEssentials.Enums.Generators.dll'"
            Link="Analyzers\CSharpEssentials.Enums.Generators.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
      <None Include="@(Analyzer)"
            Condition="'%(Filename)%(Extension)' == 'CSharpEssentials.Endpoints.Generators.dll'"
            Link="Analyzers\CSharpEssentials.Endpoints.Generators.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="CopyDependencyInjectionAnalyzerForTests" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(Analyzer)"
            Condition="'%(Filename)%(Extension)' == 'CSharpEssentials.DependencyInjection.Generators.dll'"
            Link="Analyzers\CSharpEssentials.DependencyInjection.Generators.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

  <Target Name="CopyEntityFrameworkCoreAnalyzerForTests" BeforeTargets="AssignTargetPaths" DependsOnTargets="ResolveProjectReferences">
    <ItemGroup>
      <None Include="@(Analyzer)"
            Condition="'%(Filename)%(Extension)' == 'CSharpEssentials.EntityFrameworkCore.Generators.dll'"
            Link="Analyzers\CSharpEssentials.EntityFrameworkCore.Generators.dll"
            CopyToOutputDirectory="PreserveNewest"
            Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\CSharpEssentials\CSharpEssentials.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Enums\CSharpEssentials.Enums.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Enums.Generators\CSharpEssentials.Enums.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSharpEssentials.Enums.CodeFixes\CSharpEssentials.Enums.CodeFixes.csproj" />
    <ProjectReference Include="..\CSharpEssentials.AspNetCore\CSharpEssentials.AspNetCore.csproj" />
    <ProjectReference Include="..\CSharpEssentials.AspNetCore.Swashbuckle\CSharpEssentials.AspNetCore.Swashbuckle.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Endpoints\CSharpEssentials.Endpoints.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Endpoints.Generators\CSharpEssentials.Endpoints.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSharpEssentials.Endpoints.CodeFixes\CSharpEssentials.Endpoints.CodeFixes.csproj" />
    <ProjectReference Include="..\tests\CSharpEssentials.Tests.Fixtures.EndpointsA\CSharpEssentials.Tests.Fixtures.EndpointsA.csproj" />
    <ProjectReference Include="..\tests\CSharpEssentials.Tests.Fixtures.EndpointsB\CSharpEssentials.Tests.Fixtures.EndpointsB.csproj" />
    <ProjectReference Include="..\tests\CSharpEssentials.Tests.Fixtures.EnumsContracts\CSharpEssentials.Tests.Fixtures.EnumsContracts.csproj" />
    <ProjectReference Include="..\tests\CSharpEssentials.Tests.Fixtures.OpenApiSample\CSharpEssentials.Tests.Fixtures.OpenApiSample.csproj" />
    <ProjectReference
      Include="..\CSharpEssentials.EntityFrameworkCore\CSharpEssentials.EntityFrameworkCore.csproj" />
    <ProjectReference Include="..\CSharpEssentials.EntityFrameworkCore.Generators\CSharpEssentials.EntityFrameworkCore.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSharpEssentials.EntityFrameworkCore.CodeFixes\CSharpEssentials.EntityFrameworkCore.CodeFixes.csproj" />
    <ProjectReference
      Include="..\CSharpEssentials.GcpSecretManager\CSharpEssentials.GcpSecretManager.csproj" />
    <ProjectReference
      Include="..\CSharpEssentials.RequestResponseLogging\CSharpEssentials.RequestResponseLogging.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Resilience\CSharpEssentials.Resilience.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Rules\CSharpEssentials.Rules.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Mediator\CSharpEssentials.Mediator.csproj" />
    <ProjectReference Include="..\CSharpEssentials.Validation\CSharpEssentials.Validation.csproj" />
    <ProjectReference Include="..\CSharpEssentials.These\CSharpEssentials.These.csproj" />
    <ProjectReference Include="..\CSharpEssentials.DependencyInjection\CSharpEssentials.DependencyInjection.csproj" />
    <ProjectReference Include="..\CSharpEssentials.DependencyInjection.Generators\CSharpEssentials.DependencyInjection.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\CSharpEssentials.DependencyInjection.CodeFixes\CSharpEssentials.DependencyInjection.CodeFixes.csproj" />
    <ProjectReference Include="..\tests\CSharpEssentials.Tests.Fixtures.DependencyInjectionA\CSharpEssentials.Tests.Fixtures.DependencyInjectionA.csproj" />
    <ProjectReference Include="..\tests\CSharpEssentials.Tests.Fixtures.DependencyInjectionB\CSharpEssentials.Tests.Fixtures.DependencyInjectionB.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.received.cs;**\*.verified.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>