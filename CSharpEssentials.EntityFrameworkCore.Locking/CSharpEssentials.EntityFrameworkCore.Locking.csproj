<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <PackageId>CSharpEssentials.EntityFrameworkCore.Locking</PackageId>
    <Title>CSharp Essentials EntityFrameworkCore Locking</Title>
    <Product>CSharp Essentials EntityFrameworkCore Locking</Product>
    <Description>Distributed IResourceLock for CSharpEssentials.Mediator over an EF Core relational connection: runs
      dialect SQL such as PostgreSQL pg_try_advisory_lock or SQL Server sp_getapplock, with no provider package dependency.</Description>
    <PackageTags>EntityFrameworkCore,DistributedLock,AdvisoryLock,Mediator,Locking,CSharpEssentials</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>Readme.MD</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/senrecep/CSharpEssentials</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/senrecep/CSharpEssentials</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png" Pack="true" PackagePath="\" />
    <None Include="Readme.MD" Pack="true" PackagePath="\" />
    <None Include="..\LICENCE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Pin each target framework to the EF Core major CSharpEssentials.EntityFrameworkCore compiles against; the central
       (transitively pinned) versions would otherwise move net10.0 to EF 9 and net8.0 to EF 9. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="[10.0.1,11)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="[10.0.1,11)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.Options" VersionOverride="[10.0.1,)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="[9.0.4,10)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="[8.0.0,9)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" VersionOverride="[8.0.0,9)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CSharpEssentials.EntityFrameworkCore"
      Condition="'$(UseProjectReferences)' != 'true'" />

    <ProjectReference Include="..\CSharpEssentials.EntityFrameworkCore\CSharpEssentials.EntityFrameworkCore.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
    <PackageReference Include="CSharpEssentials.Mediator"
      Condition="'$(UseProjectReferences)' != 'true'" />
    <ProjectReference Include="..\CSharpEssentials.Mediator\CSharpEssentials.Mediator.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
  </ItemGroup>

</Project>
