<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeting support -->
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>

    <PackageId>CSharpEssentials.EntityFrameworkCore</PackageId>
    <Title>CSharp Essentials EntityFrameworkCore</Title>
    <Product>CSharp Essentials EntityFrameworkCore</Product>
    <!-- Version inherited from Directory.Build.props -->
    <Authors>senrecep</Authors>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>
      EntityFrameworkCore,Result,Error,Maybe,Rule,Any,Json,Entity,DomainEvent,Utility,FunctionalProgramming,SoftDelete,AuditTrail,QueryFilters,OptimisticConcurrency,PostgreSQL,DDD,SlowQueryMonitoring,BaseEntity,QueryPerformance,NamingConventions</PackageTags>
    <Description>Enhances Entity Framework Core with functional programming patterns and
      DDD-friendly features. Includes base entity classes, soft delete support, audit trails, query
      filters, optimistic concurrency, PostgreSQL integration, query performance monitoring, and
      domain event handling. Perfect for building maintainable and scalable data access layers in
      modern .NET applications.</Description>
    <PackageProjectUrl>https://github.com/senrecep/CSharpEssentials</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <RepositoryUrl>https://github.com/senrecep/CSharpEssentials</RepositoryUrl>
    <PackageReadmeFile>Readme.MD</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\LICENCE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="Readme.MD">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <!-- EF Core packages - each target framework is compiled against (and capped to) its own EF major,
       because EF APIs such as ExecuteUpdate are not binary compatible across majors. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="EFCore.NamingConventions" VersionOverride="[10.0.0,11)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="[10.0.1,11)" />
    <!-- EF 10 needs the 10.x Microsoft.Extensions packages; lift the central (transitively pinned) 9.x versions. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" VersionOverride="[10.0.1,)" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" VersionOverride="[10.0.1,)" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="EFCore.NamingConventions" VersionOverride="[8.0.0,9)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" VersionOverride="[8.0.0,9)" />
  </ItemGroup>

  <!-- Dependencies: EntityFrameworkCore depends on Core, Entity, Enums, and Json -->
  <ItemGroup>
    <PackageReference Include="CSharpEssentials.Core"
      Condition="'$(UseProjectReferences)' != 'true'" />
    <PackageReference Include="CSharpEssentials.Entity"
      Condition="'$(UseProjectReferences)' != 'true'" />
    <PackageReference Include="CSharpEssentials.Enums"
      Condition="'$(UseProjectReferences)' != 'true'" />
    <PackageReference Include="CSharpEssentials.Json"
      Condition="'$(UseProjectReferences)' != 'true'" />

    <ProjectReference Include="..\CSharpEssentials.Core\CSharpEssentials.Core.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
    <ProjectReference Include="..\CSharpEssentials.Entity\CSharpEssentials.Entity.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
    <ProjectReference Include="..\CSharpEssentials.Enums\CSharpEssentials.Enums.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
    <ProjectReference Include="..\CSharpEssentials.Json\CSharpEssentials.Json.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
    <PackageReference Include="CSharpEssentials.Maybe"
      Condition="'$(UseProjectReferences)' != 'true'" />
    <ProjectReference Include="..\CSharpEssentials.Maybe\CSharpEssentials.Maybe.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
    <PackageReference Include="CSharpEssentials.Results"
      Condition="'$(UseProjectReferences)' != 'true'" />
    <ProjectReference Include="..\CSharpEssentials.Results\CSharpEssentials.Results.csproj"
      Condition="'$(UseProjectReferences)' == 'true'" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CSharpEssentials.Tests" />
  </ItemGroup>

  <Import Project="..\build\PackGenerator.targets" />

</Project>