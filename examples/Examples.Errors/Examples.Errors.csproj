<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AnalysisMode>None</AnalysisMode>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <!-- Demo layout: top-level blocks, types in the global namespace, Codes constants named like the fields. -->
    <NoWarn>$(NoWarn);S1199;S3903;S3218</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../CSharpEssentials.Errors/CSharpEssentials.Errors.csproj" />
  </ItemGroup>

</Project>
