<!-- Packs the companion source generator project ($(MSBuildProjectName).Generators) into this package under analyzers/dotnet/cs.
     The generator is built first through a non-referencing ProjectReference and never becomes a package or runtime dependency. -->
<Project>
  <PropertyGroup>
    <CseGeneratorProjectName Condition="'$(CseGeneratorProjectName)' == ''">$(MSBuildProjectName).Generators</CseGeneratorProjectName>
    <CseGeneratorProjectDirectory>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../$(CseGeneratorProjectName)'))</CseGeneratorProjectDirectory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(CseGeneratorProjectDirectory)/$(CseGeneratorProjectName).csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <None Include="$(CseGeneratorProjectDirectory)/bin/$(Configuration)/netstandard2.0/$(CseGeneratorProjectName).dll"
          Pack="true"
          PackagePath="analyzers/dotnet/cs"
          Visible="false" />
  </ItemGroup>
</Project>
